# =============================================================================
# ProveIT 2026 Demo Stack - Analytics - Environment Variables
# =============================================================================
# Description: Environment variables for the Analytics stack services
#
# Copy this file to .env and update the values as needed.
# Never commit .env files to version control.
#
# LIMITATION: Flow Software Config Tool requires HTTP (not HTTPS), so remote
# management via Cloudflare Tunnel is not supported. Management must be done
# from the local network or via VPN.
# =============================================================================

# -----------------------------------------------------------------------------
# Common Configuration
# -----------------------------------------------------------------------------
ANALYTICS_TZ=America/Chicago

# -----------------------------------------------------------------------------
# MSSQL Database Configuration
# -----------------------------------------------------------------------------
ANALYTICS_MSSQL_VERSION=2022-latest
ANALYTICS_MSSQL_PID=Express
ANALYTICS_MSSQL_SA_PASSWORD=Password1@
ANALYTICS_MSSQL_PORT=1433

# -----------------------------------------------------------------------------
# Flow Software Configuration
# -----------------------------------------------------------------------------
ANALYTICS_FLOW_VERSION=latest
ANALYTICS_FLOW_BOOTSTRAP_PORT=4501

# -----------------------------------------------------------------------------
# Flow Config Tool Connection
# -----------------------------------------------------------------------------
# Platform Name: <server-ip>:4501;analytics-flow-bootstrap
#
# Database must be configured via Flow Config Tool (not env vars):
#   1. Open Flow Config Tool
#   2. Connect using platform name above
#   3. Navigate to SYSTEM\Properties
#   4. Set database connection:
#      - Server: analytics-mssql,1433
#      - Database: FlowSoftware
#      - Username: sa
#      - Password: (your MSSQL password)
# -----------------------------------------------------------------------------
