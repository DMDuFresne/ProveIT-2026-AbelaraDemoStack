{
  "name": "@proveit/mes-mcp-server",
  "version": "2.0.0",
  "description": "Custom MCP server for ProveIT MES database with Streamable HTTP + OAuth",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:oauth": "node dist/index.js --oauth",
    "dev": "tsx watch src/index.ts",
    "dev:oauth": "tsx watch src/index.ts --oauth",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mes",
    "manufacturing",
    "postgres",
    "timescaledb",
    "streamable-http",
    "oauth"
  ],
  "author": "ProveIT Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
