# =============================================================================
# ProveIT 2026 Demo Stack - MES - Environment Variables
# =============================================================================
# Description: Environment variables for the MES stack services
# 
# Copy this file to .env and update the values as needed.
# Never commit .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Common Configuration
# -----------------------------------------------------------------------------
MES_TZ=America/Chicago

# -----------------------------------------------------------------------------
# TimescaleDB Configuration
# -----------------------------------------------------------------------------
MES_TIMESCALEDB_VERSION=latest-pg17
MES_POSTGRES_PASSWORD=password
MES_TIMESCALE_PORT=5433

# -----------------------------------------------------------------------------
# PgBouncer Configuration
# -----------------------------------------------------------------------------
MES_PGBOUNCER_VERSION=latest
MES_PGBOUNCER_PORT=6433

# -----------------------------------------------------------------------------
# Ignition Gateway Configuration (Common)
# -----------------------------------------------------------------------------
MES_IGNITION_EDITION=standard
MES_IGNITION_GATEWAY_ADMIN_PASSWORD=password
MES_IGNITION_GATEWAY_ADMIN_PASSWORD_FILE=
MES_GATEWAY_ADMIN_USERNAME=admin
MES_IGNITION_GATEWAY_NETWORK_ENABLED=true
MES_IGNITION_GATEWAY_NETWORK_REQUIRESSL=false
MES_IGNITION_GATEWAY_NETWORK_ALLOWINCOMING=true
MES_DISABLE_QUICKSTART=false

# -----------------------------------------------------------------------------
# MES Backend Ignition Gateway Configuration
# -----------------------------------------------------------------------------
MES_IGNITION_BACKEND_VERSION=8.3.1
MES_IGNITION_MES_BACKEND_GATEWAY_SYSTEM_NAME=ProveIT-Backend
MES_IGNITION_MES_BACKEND_NETWORK_UUID=
MES_GATEWAY_MODULES_ENABLED_BACKEND=com.inductiveautomation.eam,com.inductiveautomation.opcua,com.inductiveautomation.eventstream,com.inductiveautomation.sqlbridge,com.inductiveautomation.jdbc.postgresql
MES_GATEWAY_INIT_MEMORY_BACKEND=1024m
MES_GATEWAY_MAX_MEMORY_BACKEND=4096m
MES_IGNITION_MES_BACKEND_ACTIVATION_TOKEN=
MES_IGNITION_MES_BACKEND_ACTIVATION_TOKEN_FILE=
MES_IGNITION_BACKEND_HTTP_PORT=47010
MES_IGNITION_BACKEND_HTTPS_PORT=47011
MES_IGNITION_BACKEND_GATEWAY_PORT=47012

# -----------------------------------------------------------------------------
# MES Frontend Ignition Gateway Configuration
# -----------------------------------------------------------------------------
MES_IGNITION_FRONTEND_VERSION=8.3.1
MES_IGNITION_MES_FRONTEND_GATEWAY_SYSTEM_NAME=ProveIT-Frontend
MES_IGNITION_MES_FRONTEND_NETWORK_UUID=
MES_GATEWAY_MODULES_ENABLED_FRONTEND=com.inductiveautomation.eam,com.inductiveautomation.opcua,com.inductiveautomation.perspective,com.inductiveautomation.jdbc.postgresql
MES_GATEWAY_INIT_MEMORY_FRONTEND=1024m
MES_GATEWAY_MAX_MEMORY_FRONTEND=4096m
MES_IGNITION_MES_FRONTEND_ACTIVATION_TOKEN=
MES_IGNITION_MES_FRONTEND_ACTIVATION_TOKEN_FILE=
MES_IGNITION_FRONTEND_HTTP_PORT=47020
MES_IGNITION_FRONTEND_HTTPS_PORT=47021
MES_IGNITION_FRONTEND_GATEWAY_PORT=47022

# -----------------------------------------------------------------------------
# Nginx Reverse Proxy Configuration
# -----------------------------------------------------------------------------
MES_NGINX_VERSION=alpine
MES_NGINX_PORT=8083

# -----------------------------------------------------------------------------
# Cloudflare Tunnel Configuration
# -----------------------------------------------------------------------------
MES_CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# MCP Server Configuration (Custom Streamable HTTP + OAuth MCP Server)
# -----------------------------------------------------------------------------
# Custom MCP server built from ./mcp-server/ that provides:
# - Streamable HTTP transport (modern MCP standard)
# - Optional OAuth authentication for Claude Desktop
# - Rich schema documentation in tool descriptions
# - Read-only query execution with defense-in-depth security

# Docker image version tag (default: latest)
MES_MCP_VERSION=latest

# Port for MCP server (host:container mapping, internal container always uses 3000)
MES_MCP_PORT=48100

# =============================================================================
# External URL Configuration for OAuth
# =============================================================================
# IMPORTANT: The OAuth "protected resource" URL must EXACTLY match the URL
# that clients use to connect. If there's a mismatch, authentication fails with:
#   "Protected resource http://X does not match expected http://Y"
#
# Choose ONE of the following options based on your deployment:
#
# -----------------------------------------------------------------------------
# OPTION A: Local Development (default)
# -----------------------------------------------------------------------------
# No configuration needed. Defaults to http://localhost:48100
# Client .mcp.json: "url": "http://localhost:48100/mcp"
#
# MES_MCP_EXTERNAL_URL=
# MES_MCP_EXTERNAL_HOST=
#
# -----------------------------------------------------------------------------
# OPTION B: Direct IP Access (LAN/Testing Server)
# -----------------------------------------------------------------------------
# Use when clients connect directly to the server's IP address.
# No reverse proxy or domain name involved.
#
# Example server IP: 192.168.30.231, port 48101
#
# MES_MCP_PORT=48101
# MES_MCP_EXTERNAL_HOST=192.168.30.231
# MES_MCP_EXTERNAL_URL=
#
# Result: OAuth advertises http://192.168.30.231:48101
# Client .mcp.json: "url": "http://192.168.30.231:48101/mcp"
# Firewall: Open port 48101
#
# -----------------------------------------------------------------------------
# OPTION C: Secure Domain (Cloudflare + NGINX + HTTPS)
# -----------------------------------------------------------------------------
# Use when clients connect via a domain name with TLS termination.
# NGINX handles HTTPS and proxies to the container on HTTP.
#
# Example domain: mes-mcp.example.com
#
# MES_MCP_PORT=48100
# MES_MCP_EXTERNAL_URL=https://mes-mcp.example.com
# MES_MCP_EXTERNAL_HOST=
#
# Result: OAuth advertises https://mes-mcp.example.com
# Client .mcp.json: "url": "https://mes-mcp.example.com/mcp"
# NGINX: Proxy pass to http://127.0.0.1:48100 with buffering disabled
# Cloudflare: DNS A record pointing to your server, SSL mode Full (strict)
#
# =============================================================================

# Full external URL - use for HTTPS/domain setups (Option C)
MES_MCP_EXTERNAL_URL=

# External host/IP - use for direct IP access (Option B)
MES_MCP_EXTERNAL_HOST=

# -----------------------------------------------------------------------------
# MCP Authentication & Security
# -----------------------------------------------------------------------------

# Read-only database user password (must match TimescaleDB init script)
MES_MCP_READONLY_PASSWORD=mcp_readonly_password

# OAuth authorization password - users must enter this in browser to authorize
# Leave empty for auto-approve (development only, NOT recommended for production)
MES_MCP_AUTH_PASSWORD=

# Rate limiting: max failed auth attempts before lockout (default: 5)
MES_MCP_RATE_LIMIT_ATTEMPTS=5

# Rate limiting: lockout duration in milliseconds (default: 900000 = 15 minutes)
MES_MCP_RATE_LIMIT_WINDOW_MS=900000

# OAuth token lifetime in seconds (default: 604800 = 7 days)
# How long before the client must re-authorize
MES_MCP_OAUTH_TOKEN_EXPIRES_IN=604800

# -----------------------------------------------------------------------------
# MCP Performance Tuning
# -----------------------------------------------------------------------------

# Schema cache refresh interval in milliseconds (default: 300000 = 5 minutes)
# Background refresh detects schema changes and logs them
MES_MCP_SCHEMA_REFRESH_MS=300000

# Query timeout in milliseconds (default: 30000 = 30 seconds)
MES_MCP_QUERY_TIMEOUT_MS=30000

# Maximum rows returned per query (default: 1000)
MES_MCP_MAX_ROWS=1000

# -----------------------------------------------------------------------------
# MCP Domain Context (New in v2.1)
# -----------------------------------------------------------------------------
# The MCP server is now generic and self-documenting. It extracts context from:
# 1. Database comments (COMMENT ON SCHEMA/TABLE/COLUMN)
# 2. Optional domain context file (markdown with concepts, examples, warnings)
#
# For MES deployment, the domain context file is baked into the Docker image
# at /app/context.md and automatically loaded via DOMAIN_CONTEXT_FILE.
#
# To override with a custom context file, mount a volume:
#   volumes:
#     - ./my-context.md:/app/custom-context.md
#   environment:
#     DOMAIN_CONTEXT_FILE: /app/custom-context.md